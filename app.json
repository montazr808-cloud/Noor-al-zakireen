{
  "expo": {
    "name": "نور الذاكرين",
    "slug": "noor-al-zakireen",
    "version": "1.0.0",
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "nooralzakireen",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يحتاج التطبيق إذن الميكروفون حتى تگدر تسبح صوتياً",
        "NSSpeechRecognitionUsageDescription": "يحتاج التطبيق التعرف على الصوت حتى يعد الأذكار وانت تسبح",
        "NSLocationWhenInUseUsageDescription": "يحتاج التطبيق موقعك لحساب أوقات الصلاة واتجاه القبلة بدقة"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#4586BE"
      },
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "package": "com.anonymous.nooralzakireen"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "يحتاج التطبيق إذن الميكروفون حتى تگدر تسبح صوتياً",
          "speechRecognitionPermission": "يحتاج التطبيق التعرف على الصوت حتى يعد الأذكار وانت تسبح"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يحتاج التطبيق موقعك لحساب أوقات الصلاة واتجاه القبلة بدقة"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "يحتاج التطبيق الوصول لمعرض الصور حتى يحفظ الخلفيات",
          "savePhotosPermission": "يحتاج التطبيق إذن حفظ الصور بمعرض الهاتف"
        }
      ],
      "expo-audio",
      "expo-web-browser",
      "expo-asset",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#4586BE"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/withNotificationIcons.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d548a406-9911-4691-8244-57844d5330a9"
      }
    },
    "owner": "montazr99"
  }
}